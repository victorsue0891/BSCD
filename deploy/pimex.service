[Unit]
Description=PIMEX fullscreen instrument interface
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/Photoelectromagnetic-electrochemical
ExecStart=/usr/bin/python3 -u %h/Photoelectromagnetic-electrochemical/main.py --fullscreen --port /dev/ttyUSB0 --line-ending LF --data-dir %h/PIMEX/data
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=graphical-session.target
